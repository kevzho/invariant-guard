{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invariantguard:schema:finding:1.0",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/finding_id"
    },
    "obligation_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/obligation_id"
    },
    "symbol_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/symbol_id"
    },
    "property_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/property_id"
    },
    "property_result": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/property_result"
    },
    "scope_validity": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/scope_validity"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/authority"
    },
    "patch_relation": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/patch_relation"
    },
    "severity": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/severity"
    },
    "source_span": {
      "$ref": "urn:invariantguard:schema:source_span:1.0"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "quantifier": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "domain_source": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/domain_source"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "witness": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
        },
        {
          "type": "null"
        }
      ]
    },
    "witness_validated": {
      "type": "boolean"
    },
    "runtime_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:invariantguard:schema:common:1.0#/$defs/evidence_id"
      }
    },
    "replay_available": {
      "type": "boolean"
    },
    "comparison": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/comparison"
    },
    "contract": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/contract_ref"
    }
  },
  "required": [
    "assumptions",
    "authority",
    "domain",
    "domain_source",
    "evidence_ids",
    "finding_id",
    "message",
    "obligation_id",
    "patch_relation",
    "path_constraints",
    "property_id",
    "property_result",
    "quantifier",
    "reasons",
    "replay_available",
    "runtime_mode",
    "scope_validity",
    "severity",
    "source_span",
    "symbol_id",
    "witness",
    "witness_validated"
  ],
  "allOf": [
    {
      "not": {
        "properties": {
          "property_result": {
            "const": "PROVED_SAFE"
          }
        },
        "required": [
          "property_result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "not": {
              "const": "UNKNOWN"
            }
          }
        }
      },
      "then": {
        "properties": {
          "scope_validity": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/scope_validity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "const": "PROVED_UNSAFE"
          }
        }
      },
      "then": {
        "properties": {
          "witness": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
          },
          "witness_validated": {
            "const": true
          }
        }
      }
    },
    {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/result_scope_rules"
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "enum": [
              "OBSERVED_REGRESSION"
            ]
          }
        }
      },
      "then": {
        "required": [
          "contract"
        ],
        "properties": {
          "witness": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
          },
          "witness_validated": {
            "const": true
          },
          "scope_validity": {
            "const": "EXECUTED"
          }
        }
      }
    }
  ]
}
