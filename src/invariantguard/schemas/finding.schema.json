{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invariantguard:schema:finding:1.0",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/finding_id"
    },
    "obligation_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/obligation_id"
    },
    "symbol_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/symbol_id"
    },
    "property_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/property_id"
    },
    "property_result": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/property_result"
    },
    "scope_validity": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/scope_validity"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/authority"
    },
    "patch_relation": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/patch_relation"
    },
    "severity": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/severity"
    },
    "source_span": {
      "$ref": "urn:invariantguard:schema:source_span:1.0"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "quantifier": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "domain_source": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/domain_source"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "witness": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
        },
        {
          "type": "null"
        }
      ]
    },
    "witness_validated": {
      "type": "boolean"
    },
    "runtime_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:invariantguard:schema:common:1.0#/$defs/evidence_id"
      }
    },
    "replay_available": {
      "type": "boolean"
    },
    "comparison": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/comparison"
    },
    "contract": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/contract_ref"
    },
    "behavior": {
      "description": "Differential replay (behavior.base_equivalence): one confirmed cluster of base/patch differences with its shortest replayable witness and the question for the agent.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "difference_class": {
          "enum": [
            "different_return",
            "different_mutation",
            "new_exception",
            "removed_exception",
            "different_exception",
            "exception_message",
            "timeout"
          ]
        },
        "changed_symbol": {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/symbol_id"
        },
        "observed_through": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "urn:invariantguard:schema:common:1.0#/$defs/symbol_id"
            },
            "relation": {
              "enum": [
                "direct",
                "constructor",
                "caller",
                "data_reader"
              ]
            }
          },
          "required": [
            "target",
            "relation"
          ]
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "call": {
              "type": "string",
              "minLength": 1
            },
            "input_origin": {
              "type": "string",
              "minLength": 1
            },
            "base": {
              "type": "string"
            },
            "patch": {
              "type": "string"
            }
          },
          "required": [
            "call",
            "input_origin",
            "base",
            "patch"
          ]
        },
        "examples_in_cluster": {
          "type": "integer",
          "minimum": 1
        },
        "input_origins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acknowledged_by_patch_tests": {
          "type": "boolean"
        },
        "confirmed_runs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base": {
              "type": "integer",
              "minimum": 0
            },
            "patch": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "base",
            "patch"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "if_intended": {
          "type": "string",
          "minLength": 1
        },
        "if_not_intended": {
          "type": "string",
          "minLength": 1
        },
        "accepted_by": {
          "type": "string",
          "pattern": "^bd-accept-[0-9a-f]{16}$"
        }
      },
      "required": [
        "difference_class",
        "changed_symbol",
        "observed_through",
        "witness",
        "examples_in_cluster",
        "input_origins",
        "acknowledged_by_patch_tests",
        "confirmed_runs",
        "question",
        "if_intended",
        "if_not_intended"
      ]
    },
    "declared": {
      "description": "Declared (doctest) or approved (pinned) behavior that regressed under differential replay (pivot phase 5).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "doctest",
            "pin"
          ]
        },
        "call": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "call",
        "expected",
        "base",
        "patch"
      ]
    }
  },
  "required": [
    "assumptions",
    "authority",
    "domain",
    "domain_source",
    "evidence_ids",
    "finding_id",
    "message",
    "obligation_id",
    "patch_relation",
    "path_constraints",
    "property_id",
    "property_result",
    "quantifier",
    "reasons",
    "replay_available",
    "runtime_mode",
    "scope_validity",
    "severity",
    "source_span",
    "symbol_id",
    "witness",
    "witness_validated"
  ],
  "allOf": [
    {
      "not": {
        "properties": {
          "property_result": {
            "const": "PROVED_SAFE"
          }
        },
        "required": [
          "property_result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "not": {
              "const": "UNKNOWN"
            }
          }
        }
      },
      "then": {
        "properties": {
          "scope_validity": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/scope_validity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "const": "PROVED_UNSAFE"
          }
        }
      },
      "then": {
        "properties": {
          "witness": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
          },
          "witness_validated": {
            "const": true
          }
        }
      }
    },
    {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/result_scope_rules"
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "enum": [
              "OBSERVED_REGRESSION"
            ]
          }
        }
      },
      "then": {
        "required": [
          "contract"
        ],
        "properties": {
          "witness": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
          },
          "witness_validated": {
            "const": true
          },
          "scope_validity": {
            "const": "EXECUTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "const": "OBSERVED_DIFFERENCE"
          }
        },
        "required": [
          "property_result"
        ]
      },
      "then": {
        "required": [
          "behavior"
        ],
        "properties": {
          "scope_validity": {
            "const": "EXECUTED"
          },
          "authority": {
            "const": "INFERRED"
          },
          "patch_relation": {
            "const": "CHANGED"
          },
          "severity": {
            "enum": [
              "WARNING",
              "INFO"
            ]
          },
          "witness": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "behavior"
        ]
      },
      "then": {
        "properties": {
          "property_result": {
            "const": "OBSERVED_DIFFERENCE"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "declared"
        ]
      },
      "then": {
        "required": [
          "contract"
        ],
        "properties": {
          "property_result": {
            "const": "OBSERVED_REGRESSION"
          },
          "authority": {
            "enum": [
              "DECLARED",
              "APPROVED"
            ]
          }
        }
      }
    }
  ]
}
