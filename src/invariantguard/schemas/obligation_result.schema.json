{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invariantguard:schema:obligation_result:1.0",
  "title": "ObligationResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "obligation_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/obligation_id"
    },
    "symbol_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/symbol_id"
    },
    "property_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/property_id"
    },
    "operation": {
      "enum": [
        "DIV",
        "FLOORDIV",
        "MOD",
        "INDEX",
        "ATTRIBUTE"
      ]
    },
    "operation_text": {
      "type": "string"
    },
    "divisor_text": {
      "type": "string"
    },
    "property_result": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/property_result"
    },
    "scope_validity": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/scope_validity"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/authority"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "domain_source": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/domain_source"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quantifier": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/analysis_method"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_span": {
      "$ref": "urn:invariantguard:schema:source_span:1.0"
    },
    "required": {
      "type": "boolean"
    },
    "witness": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
        },
        {
          "type": "null"
        }
      ]
    },
    "witness_validated": {
      "type": "boolean"
    },
    "path_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:invariantguard:schema:common:1.0#/$defs/evidence_id"
      }
    },
    "finding_id": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/finding_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "divisor_fact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "anchor": {
      "type": "string",
      "description": "Structural anchor for matching across snapshots (no line numbers)."
    },
    "via": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "callee": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/symbol_id"
          },
          "call": {
            "type": "string",
            "minLength": 1
          },
          "call_span": {
            "$ref": "urn:invariantguard:schema:source_span:1.0"
          }
        },
        "required": [
          "call",
          "call_span",
          "callee"
        ]
      }
    },
    "evidence_reused": {
      "const": true
    },
    "patch_relation": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/patch_relation"
    }
  },
  "required": [
    "assumptions",
    "authority",
    "divisor_fact",
    "divisor_text",
    "domain",
    "domain_source",
    "evidence_ids",
    "finding_id",
    "method",
    "obligation_id",
    "operation",
    "operation_text",
    "path_constraints",
    "property_id",
    "property_result",
    "quantifier",
    "reasons",
    "required",
    "runtime_mode",
    "scope_validity",
    "source_span",
    "symbol_id",
    "witness",
    "witness_validated"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "property_result": {
            "not": {
              "const": "UNKNOWN"
            }
          }
        }
      },
      "then": {
        "properties": {
          "scope_validity": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/scope_validity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "property_result": {
            "const": "PROVED_UNSAFE"
          }
        }
      },
      "then": {
        "properties": {
          "witness": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/witness"
          },
          "witness_validated": {
            "const": true
          }
        }
      }
    },
    {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/result_scope_rules"
    }
  ]
}
