{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invariantguard:schema:candidate_batch:1.0",
  "title": "CandidateBatch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/schema_version"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch-[0-9a-f]{32}$"
    },
    "snapshot_id": {
      "$ref": "urn:invariantguard:schema:common:1.0#/$defs/digest"
    },
    "source": {
      "enum": [
        "template",
        "local_model",
        "remote_model",
        "agent_proposed"
      ]
    },
    "model_identity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "quantization": {
              "type": "string"
            }
          },
          "required": [
            "artifact_id",
            "license",
            "quantization",
            "revision",
            "runtime"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "context_packet_digest": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^cand-[0-9a-f]{16,64}$"
          },
          "scope": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/symbol_id"
          },
          "precondition": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/dsl_node"
          },
          "predicate": {
            "$ref": "urn:invariantguard:schema:common:1.0#/$defs/dsl_node"
          },
          "input_profile": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:invariantguard:schema:source_span:1.0"
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "uncertainty": {
            "type": "string",
            "maxLength": 1000
          },
          "unsupported_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "boundary_inputs": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "boundary_inputs",
          "candidate_id",
          "input_profile",
          "precondition",
          "predicate",
          "rationale",
          "scope",
          "source_refs",
          "uncertainty",
          "unsupported_dependencies"
        ]
      }
    },
    "data_egress": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/data_egress"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposer_client": {
      "anyOf": [
        {
          "$ref": "urn:invariantguard:schema:common:1.0#/$defs/proposer_client"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "batch_id",
    "candidates",
    "context_packet_digest",
    "model_identity",
    "schema_version",
    "snapshot_id",
    "source"
  ]
}
